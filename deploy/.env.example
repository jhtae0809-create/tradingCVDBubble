# Copy to deploy/.env and fill in. Gitignored — never commit real values.
#
#   cp deploy/.env.example deploy/.env

# IBKR login for the headless Gateway.
# Use the PAPER account: a live login needs 2FA approval on a phone every time
# Gateway restarts (it restarts daily), so an unattended live deployment stops
# collecting every day. Paper gets the identical real-time feed once
# "Share real-time market data with paper account" is on in Client Portal.
TWS_USERID = "your_ibkr_username"
TWS_PASSWORD = "your_ibkr_password"

# paper -> Gateway listens on 4002 | live -> 4001. Keep IB_API_PORT in step.
TRADING_MODE = "paper"
IB_API_PORT = "4002"

# FinViz Elite, for consolidated bars (volume scaling). Optional: without it the
# dashboard draws but shows the red "FinViz unavailable" banner.
FINVIZ_USERNAME = "example@email.com"
FINVIZ_PASSWORD = "password"
