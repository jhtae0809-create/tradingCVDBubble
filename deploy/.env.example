# Copy to deploy/.env and fill in. Gitignored — never commit real values.
#
#   cp deploy/.env.example deploy/.env

# ── IBKR login for the headless Gateway ──────────────────────────────────────
# Use the PAPER account. A live login needs 2FA approval on a phone every time
# Gateway restarts (it restarts daily), so an unattended deployment stops
# collecting every day. Paper receives the identical real-time feed once
# "Share real-time market data with paper account" is enabled in Client Portal.
#
# NOTE: the Gateway image's own variables are called TWS_USERID / TWS_PASSWORD
# (it drives IBC, which covers Gateway and TWS under one set of names). These
# are named for what you are actually running; docker-compose.yml maps them.
IB_USERNAME = "your_ibkr_paper_username"
IB_PASSWORD = "your_ibkr_paper_password"

# paper or live. Keep IB_API_PORT in step with it.
TRADING_MODE = "paper"
# The port to DIAL, which is not the port Gateway prints. Gateway binds its API
# to loopback (4002 paper / 4001 live) and the image republishes it with socat
# two above: 4004 for paper, 4003 for live. Dial the socat one.
IB_API_PORT = "4004"

# What to do when IBKR reports the account is already logged in somewhere else
# (phone app, Client Portal, a Gateway on your laptop). Leave this alone unless
# you know you want the opposite: the default takes the session and keeps it.
#   primary          - take over, and refuse to be displaced later (default)
#   primaryoverride  - take over, but let a later session take it back
#   secondary        - yield; this Gateway exits and collects nothing
# Do NOT set "manual": there is no screen in the container to click the dialog,
# so Gateway hangs at login forever and the API port never opens.
EXISTING_SESSION_DETECTED_ACTION = "primary"

# ── FinViz Elite ─────────────────────────────────────────────────────────────
# Consolidated bars, used to scale tick volume to real traded volume. Without
# it the dashboard draws but shows the red "FinViz unavailable" banner.
FINVIZ_USERNAME = "example@email.com"
FINVIZ_PASSWORD = "password"
