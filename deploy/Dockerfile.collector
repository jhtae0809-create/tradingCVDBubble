# The COLLECTOR image: connects to IB Gateway and writes ticks, 1-second bars
# and L2 depth into MongoDB. Separate from the dashboard image on purpose —
# this one needs the full requirements.txt (ib_async, the FinViz client) and
# has no web port, while the dashboard needs neither and serves HTTP.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# No CMD arguments baked in: the collector's flags (--port, --client-id,
# --backfill-hours, --no-smart) are deployment decisions, so they are set as
# the service's start command instead of rebuilt into the image.
CMD ["python", "-m", "ibkr.dynamic_collector"]
