# Copy this file to .env and fill in your FinViz Elite credentials:
#
#     cp .env.example .env        (macOS / Linux)
#     copy .env.example .env      (Windows)
#
# .env is gitignored, so every fresh clone starts without one. These two values
# are all you need: the first FinViz fetch logs in with them, writes the API
# token to finviz/api_keys.py and retries, so the token is never something you
# set by hand. Without them there is nothing to log in with, and the dashboard
# reports "FinViz unavailable" and draws unscaled tick volume.
FINVIZ_USERNAME = "example@email.com"
FINVIZ_PASSWORD = "password"

# NOTE: the API token does NOT go here. It is generated state, written to
# finviz/api_keys.py and rewritten on every renewal.
